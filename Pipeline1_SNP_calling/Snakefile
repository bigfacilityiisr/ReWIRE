configfile: "config/config.yaml"
REF = config["reference"]
DATA = config["data_dir"]
SE_SAMPLES = config["se_samples"]
PE_SAMPLES = config["pe_samples"]
SAMPLES = SE_SAMPLES + PE_SAMPLES
print("Samples:", SAMPLES)
rule all:
    input:
        expand(f"{DATA}/fastq/{{sample}}.fastq.gz", sample=SE_SAMPLES),
        expand(f"{DATA}/fastq/{{sample}}_R1.fastq.gz", sample=PE_SAMPLES),
        expand(f"{DATA}/fastq/{{sample}}_R2.fastq.gz", sample=PE_SAMPLES),
        expand(f"{DATA}/fastqc/{{sample}}_fastqc.html", sample=SE_SAMPLES),
        expand(f"{DATA}/fastqc/{{sample}}_R1_fastqc.html", sample=PE_SAMPLES),
        expand(f"{DATA}/fastqc/{{sample}}_R2_fastqc.html", sample=PE_SAMPLES),
        f"{DATA}/multiqc/multiqc_report.html",
        "results/variants/final_variants.vcf.gz"
include: "rules/download.smk"
include: "rules/fasterq.smk"
include: "rules/fastqc_se.smk"
include: "rules/fastqc_pe.smk"
include: "rules/multiqc.smk"
include: "rules/trimming.smk"
include: "rules/reference.smk"
include: "rules/alignment.smk"
include: "rules/dedup.smk"
include: "rules/gvcf_r1.smk"
include: "rules/bqsr.smk"
include: "rules/gvcf_r2.smk"
include: "rules/bqsr2.smk"
include: "rules/bqsr3.smk"
include: "rules/final_genotype.smk"
